# Dependencies
node_modules/

# Git worktrees
.worktrees/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Claude session data (ephemeral, not project files)
.claude/projects/
.claude/settings.json
.claude/settings.local.json

# Python cache
__pycache__/
*.pyc

# Temporary files
*.tmp
*.bak
*.pid

# Archived legacy generators
generators/

# === Generated content (not part of the engine) ===

# Product knowledge bases (user provides these per-product)
knowledge-base/*.md
!knowledge-base/SCHEMA.md

# All generated output (docs, scripts, images, PDFs)
output/*/
output/manifest.json
output/topic-index.json

# Keep logo assets (used by the generator)
!output/LOGOMARK.png
!output/LOGOTYPE.png

# Product images
images/
